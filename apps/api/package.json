{
  "name": "@medagenda/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@medagenda/shared": "workspace:*",
    "fastify": "5.12.7",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@medagenda/config": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
