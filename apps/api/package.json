{
  "name": "@medagenda/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "keys:generate": "tsx scripts/keys-generate.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/csrf-protection": "8.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@medagenda/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "fastify": "5.12.7",
    "ics": "3.12.1",
    "nodemailer": "10.6.0",
    "otplib": "13.6.0",
    "qrcode": "1.5.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@medagenda/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "eslint": "9.39.5",
    "node-ical": "0.27.6",
    "prisma": "6.19.3",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts"
  }
}
