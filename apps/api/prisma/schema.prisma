// Fields suffixed Enc are AES-256-GCM ciphertext (see src/lib/crypto.ts).
// Fields suffixed Hash marked as blind indexes are HMAC-SHA256 hex values used for lookups.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  ADMIN
}

enum EmailTokenPurpose {
  VERIFY
  RESET
}

enum ProviderKind {
  DOCTOR
  EXAM_RESOURCE
}

enum ServiceType {
  CONSULTATION
  EXAM
}

enum SlotStatus {
  OPEN
  BOOKED
  BLOCKED
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id               String    @id @default(cuid())
  emailEnc         Bytes
  emailHash        String    @unique // blind index
  passwordHash     String
  locale           String    @default("pt-BR") // "pt-BR" | "en", validated by shared Zod schema
  role             Role      @default(PATIENT)
  emailVerifiedAt  DateTime?
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  profile       PatientProfile?
  sessions      Session[]
  emailTokens   EmailToken[]
  appointments  Appointment[]
  calendarFeed  CalendarFeed?
  auditLogs     AuditLog[]
}

model PatientProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  fullNameEnc        Bytes
  cpfEnc             Bytes? // optional at registration
  cpfHash            String?  @unique // blind index
  birthDateEnc       Bytes
  phoneEnc           Bytes
  healthInsuranceEnc Bytes?
  consentLgpdAt      DateTime
  consentVersion     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique // SHA-256 of opaque token
  userAgent  String?
  ipHash     String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailToken {
  id        String            @id @default(cuid())
  userId    String
  purpose   EmailTokenPurpose
  tokenHash String            @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Specialty {
  id     String @id @default(cuid())
  slug   String @unique
  namePt String
  nameEn String

  providers ProviderSpecialty[]
  slots     Slot[]
}

model ExamType {
  id            String @id @default(cuid())
  slug          String @unique
  namePt        String
  nameEn        String
  preparationPt String
  preparationEn String
  durationMin   Int

  providers ProviderExam[]
  slots     Slot[]
}

model Clinic {
  id       String @id @default(cuid())
  name     String
  address  String
  city     String
  state    String
  phone    String
  timezone String @default("America/Sao_Paulo")
  lat      Float?
  lng      Float?

  providers Provider[]
}

model Provider {
  id       String       @id @default(cuid())
  clinicId String
  name     String
  crm      String?
  kind     ProviderKind
  bioPt    String       @default("")
  bioEn    String       @default("")

  clinic      Clinic              @relation(fields: [clinicId], references: [id])
  specialties ProviderSpecialty[]
  exams       ProviderExam[]
  slots       Slot[]

  @@index([clinicId])
}

model ProviderSpecialty {
  providerId  String
  specialtyId String

  provider  Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([providerId, specialtyId])
}

model ProviderExam {
  providerId String
  examTypeId String

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Cascade)

  @@id([providerId, examTypeId])
}

model Slot {
  id          String      @id @default(cuid())
  providerId  String
  startsAt    DateTime
  endsAt      DateTime
  serviceType ServiceType
  specialtyId String?
  examTypeId  String?
  status      SlotStatus  @default(OPEN)

  provider    Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  specialty   Specialty?   @relation(fields: [specialtyId], references: [id])
  examType    ExamType?    @relation(fields: [examTypeId], references: [id])
  appointments Appointment[]

  // The unique constraint also provides the (providerId, startsAt) index.
  @@unique([providerId, startsAt])
  @@index([status, startsAt])
}

model Appointment {
  id          String            @id @default(cuid())
  userId      String
  slotId      String // double-booking backstop: partial unique index on non-cancelled rows (see migration)
  status      AppointmentStatus @default(SCHEDULED)
  notesEnc    Bytes?
  icsUid      String            @default(uuid())
  sequence    Int               @default(0)
  createdAt   DateTime          @default(now())
  cancelledAt DateTime?

  user User @relation(fields: [userId], references: [id])
  slot Slot @relation(fields: [slotId], references: [id])

  @@index([userId, status])
  @@index([slotId])
}

model CalendarFeed {
  id        String    @id @default(cuid())
  userId    String    @unique
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ipHash    String?
  createdAt DateTime @default(now())
  meta      Json     @default("{}")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
}
