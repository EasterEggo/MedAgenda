# Copy to .env (git-ignored) and replace every placeholder before use.
# Never commit real secrets.

NODE_ENV=development

# API (apps/api)
API_HOST=127.0.0.1
API_PORT=3001

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=medagenda
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=medagenda
POSTGRES_PORT=5432
DATABASE_URL=postgresql://medagenda:change-me-local-only@localhost:5432/medagenda?schema=public

# Mail (Mailpit in dev, docker-compose.yml; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# Field encryption (apps/api/src/lib/crypto.ts). Generate with: pnpm keys:generate
# DATA_KEYS is a JSON map of key version -> base64 32-byte key; add a new version to rotate.
DATA_KEYS={"1":"REPLACE_WITH_BASE64_32_BYTES"}
DATA_KEY_CURRENT=1
# Separate HMAC key for blind indexes (email, CPF lookups). Never reuse a data key.
BLIND_INDEX_KEY=REPLACE_WITH_BASE64_32_BYTES
