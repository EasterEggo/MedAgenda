{
  "name": "medagenda",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "keys:generate": "pnpm --filter @medagenda/api keys:generate",
    "db:migrate": "pnpm --filter @medagenda/api db:migrate",
    "db:seed": "pnpm --filter @medagenda/api db:seed"
  },
  "devDependencies": {
    "@medagenda/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
